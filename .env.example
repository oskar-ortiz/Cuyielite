# Copiar a .env y completar. NUNCA subir .env al repositorio.
DB_PASSWORD=cambiar_esto
# Puerto propio del piloto local (5432 puede estar ocupado por otro PostgreSQL)
DB_PORT=5434

# psycopg 3 acepta postgresql://; el backend no usa asyncpg
DATABASE_URL=postgresql://cuyielite:cambiar_esto@127.0.0.1:5434/cuyielite
JWT_SECRET=cambiar_esto
CUYIELITE_AUTH_JWT_SECRET=cambiar_esto
CUYIELITE_AUTH_ISSUER=cuyielite-local
CUYIELITE_AUTH_AUDIENCE=cuyielite-pilot-local
CUYIELITE_AUTH_MODE=pilot
JWT_EXPIRE_MINUTES=60
# Solo para el laboratorio de sincronizacion; generar y persistir fuera de Git.
SYNC_CURSOR_SIGNING_KEY=

# GeneraciÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â³n local del RAG. Ollama no se invoca por defecto.
LLM_PROVIDER=none
# Base aislada del corpus RAG (bootstrap + migraciones aplicadas)
RAG_DATABASE_URL=postgresql://cuyielite:cambiar_esto@127.0.0.1:5434/cuyielite_rag
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
LLM_TIMEOUT_S=60
LLM_TEMPERATURE=0.1
