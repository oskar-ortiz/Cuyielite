# Copiar a .env y completar. NUNCA subir .env al repositorio.
DB_PASSWORD=cambiar_esto
DATABASE_URL=postgresql+asyncpg://cuyielite:cambiar_esto@localhost:5432/cuyielite
JWT_SECRET=cambiar_esto
JWT_EXPIRE_MINUTES=60
# Solo para el laboratorio de sincronizacion; generar y persistir fuera de Git.
SYNC_CURSOR_SIGNING_KEY=

# Generación local del RAG. Ollama no se invoca por defecto.
LLM_PROVIDER=none
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
LLM_TIMEOUT_S=60
LLM_TEMPERATURE=0.1
